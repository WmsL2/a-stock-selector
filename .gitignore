# Local environments and Python artifacts
.venv/
venv/
__pycache__/
*.py[cod]
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/.cache/
backend/**/*.egg-info/
backend/build/
backend/dist/

# Frontend artifacts
frontend/node_modules/
